{
  "name": "stablepay",
  "private": true,
  "workspaces": [
    "contracts",
    "cre-workflow",
    "frontend"
  ],
  "scripts": {
    "backend:dev": "cargo run --manifest-path backend/Cargo.toml",
    "contracts:compile": "npm run compile -w contracts",
    "contracts:deploy": "npm run deploy -w contracts",
    "cre:simulate": "cre workflow simulate ./stablepay-payroll -T dev --trigger-index 0 --project-root ./stablepay-cre",
    "cre:typecheck": "bunx tsc -p stablepay-cre/stablepay-payroll/tsconfig.json --noEmit",
    "frontend:dev": "npm run dev -w frontend",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  }
}
